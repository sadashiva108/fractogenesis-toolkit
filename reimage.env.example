# reimage.env.example
# Template for fractogenesis-toolkit local config.
#
# Copy this file to reimage.env, edit it for the current Mac, then keep
# reimage.env local/private (already in .gitignore).
#
# Commit this example file. Do not commit reimage.env.
#
# Important:
# - reimage.env should contain resolved values only.
# - Do not put shell expressions such as ${VAR:-...}, $HOME/..., or
#   $EXTERNAL_DATA_VOLUME/... in reimage.env values.
# - Optional paths can stay blank until that workflow is used.
# - Replace /Users/<user>/... examples with the real absolute path on the Mac.
#
# Naming conventions used below:
# - _VOLUME  = a physical/mounted external volume (matches diskutil's own
#              vocabulary and this repo's "External Data Volume" troubleshooting
#              sections)
# - _ROOT    = the top of a generated tree with many child subfolders
#              (system-inventory/, performance-audit/, secrets-encrypted/, etc.)
#
# Note: there is no REIMAGE_ROOT here. prepare-artifact-root.py self-locates
# from its own position in this repo (bin/) — nothing needs to be told where
# the repo is. FRACTOGENESIS_HOME (where this repo is checked out) is a shell
# startup / .envrc concern, not something reimage.env stores.

# -----------------------------------------------------------------------------
# Core reimage workflow paths
# -----------------------------------------------------------------------------

# Parent external data/artifact volume — the physical/mounted volume only,
# not the specific event folder created on it (that's REIMAGE_ARTIFACT_ROOT,
# below).
export EXTERNAL_DATA_VOLUME="/Volumes/Data"

# Optional dedicated Time Machine destination volume.
export EXTERNAL_APPLE_BACKUPS_VOLUME=""

# Small dedicated jump drive used as the no-network bootstrap fallback.
# Not read by prepare-artifact-root.py directly — documented here for your
# own reference alongside the other volume paths.
export JUMP_DRIVE_VOLUME="/Volumes/REIMAGEKIT"

# GitHub account this toolkit is cloned and bootstrapped from. Runbooks build
# the clone and bootstrap URLs from it rather than hardcoding an account, since
# each user forks or clones the toolkit to their own.
#
# Deliberately NOT the source of truth for the very first fetch after an erase:
# reimage.env does not survive the erase either, so anything that can hand you
# this file (the jump drive, the artifact volume) has already handed you the
# toolkit. On a bare Mac the account comes from the post-reimage cheatsheet you
# emailed yourself. This key serves every use after that point.
export TOOLKIT_GITHUB_ACCOUNT=""

# Deliberately absent: the secrets DMG password. reimage.env sits in plaintext
# on the artifact volume beside the DMG and on the jump drive, and is sourced
# with `set -a` into the environment of every script in the workflow. Storing
# the password here would defeat the encryption it protects. Keep it in your
# password manager and record only the entry NAME in the cheatsheet.

# Asset tag or hostname used in the artifact root name.
export ASSET_OR_HOST="<asset-or-host>"

# Date the reimage effort started, in YYYYMMDD format.
export REIMAGE_START_DATE="YYYYMMDD"

# Dedicated artifact root for this reimage event — backups, captures,
# secrets DMG, checklists, sign-off templates all live under here.
# Resolved by setup-reimage-env.sh at creation time, from the volume and
# naming-convention steps that come before it — not written later.
export REIMAGE_ARTIFACT_ROOT=""

# -----------------------------------------------------------------------------
# Optional workflow paths
# -----------------------------------------------------------------------------

export REIMAGE_WORKSPACE_ROOT=""
export PERFORMANCE_HISTORY_SOURCE=""
export OFFICE_WATCH=""
export ONEDRIVE_FOLDER_NAME=""
# Directory the OneDrive sync folder lives under. Blank uses the macOS
# default, $HOME/Library/CloudStorage. Set it when the sync folder is not a
# file-provider mount.
export ONEDRIVE_PARENT_DIR=""
export ONEDRIVE_ROOT=""
export ONEDRIVE_DEST_SUBDIR=""

# -----------------------------------------------------------------------------
# Git repository roots for backup-git-repository.md
# -----------------------------------------------------------------------------

export GIT_WORK_REPO_ROOT=""
export GIT_PERSONAL_REPO_ROOT=""

# -----------------------------------------------------------------------------
# Optional Git setup values
# -----------------------------------------------------------------------------

export GIT_WORK_NAME=""
export GIT_WORK_EMAIL=""
export GIT_PERSONAL_NAME=""
export GIT_PERSONAL_EMAIL=""
export GIT_WORK_GITHUB_HOST="github.com"
export GIT_PERSONAL_GITHUB_HOST="github-personal"
# GitHub account that owns your PERSONAL repos. restore-repos.sh rewrites a
# clone URL to GIT_PERSONAL_GITHUB_HOST only when the URL owner matches this,
# so a work-org repo sitting under the personal root is never handed a
# personal SSH alias. Blank = never rewrite, just flag for review.
export GIT_PERSONAL_GITHUB_OWNER=""
export GIT_WORK_SSH_KEY=""
export GIT_PERSONAL_SSH_KEY=""
export GIT_DEFAULT_BRANCH="main"
